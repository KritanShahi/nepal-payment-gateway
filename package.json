{
  "name": "nepal-payment-gateway",
  "version": "1.0.0",
  "description": "A modern, unified Node.js SDK for integrating eSewa (ePay v2) and Khalti (ePayment v2) payment gateways in Nepal.",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./esewa": {
      "types": "./dist/esewa.d.ts",
      "import": "./dist/esewa.mjs",
      "require": "./dist/esewa.cjs"
    },
    "./khalti": {
      "types": "./dist/khalti.d.ts",
      "import": "./dist/khalti.mjs",
      "require": "./dist/khalti.cjs"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "import": "./dist/next.mjs",
      "require": "./dist/next.cjs"
    },
    "./express": {
      "types": "./dist/express.d.ts",
      "import": "./dist/express.mjs",
      "require": "./dist/express.cjs"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "nepal",
    "payment",
    "gateway",
    "esewa",
    "khalti",
    "epay",
    "nepal-payment",
    "sdk",
    "fintech",
    "nepal-payment-gateway",
    "digital-wallet",
    "nepal-gateway"
  ],
  "author": "Kritan",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/KritanShahi/nepal-payment-gateway.git"
  },
  "bugs": {
    "url": "https://github.com/KritanShahi/nepal-payment-gateway/issues"
  },
  "homepage": "https://github.com/KritanShahi/nepal-payment-gateway#readme",
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "tsup": "^8.3.6",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
