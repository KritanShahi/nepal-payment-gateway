# ===============================================
# Nepal Payment Gateway Environment Configuration
# ===============================================
# All variables are read lazily at call time, so loading them with
# dotenv.config() after importing the package works fine.

# -----------------------------------------------
# eSewa
# -----------------------------------------------
# Public sandbox credentials (auto-applied when ESEWA_IS_TEST=true, so these
# two lines are optional for testing). Replace with your merchant credentials
# from eSewa for production.
ESEWA_PRODUCT_CODE=EPAYTEST
ESEWA_SECRET_KEY=8gBm/:&EnhH.1/q
ESEWA_IS_TEST=true
# Optional endpoint override (sandbox: https://rc-epay.esewa.com.np, production: https://epay.esewa.com.np)
# ESEWA_BASE_URL=

# -----------------------------------------------
# Khalti
# -----------------------------------------------
# Get a TEST secret key from https://test-admin.khalti.com and a LIVE key from
# https://admin.khalti.com. Note: Khalti names even its sandbox keys
# "live_secret_key_..." — the dashboard it came from is what matters.
# NEVER commit a real live key to version control.
KHALTI_SECRET_KEY=your_khalti_test_secret_key
KHALTI_IS_TEST=true
# Optional endpoint override (sandbox: https://dev.khalti.com/api/v2, production: https://khalti.com/api/v2)
# KHALTI_BASE_URL=
